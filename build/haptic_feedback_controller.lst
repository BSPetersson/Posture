  96:Core/Src/haptic_feedback_controller.c **** /**
  97:Core/Src/haptic_feedback_controller.c ****  * @brief Initializes the haptic feedback controller for a wideband LRA.
  98:Core/Src/haptic_feedback_controller.c ****  *
  99:Core/Src/haptic_feedback_controller.c ****  * This function configures the DRV2605L driver for a wideband LRA actuator.
 100:Core/Src/haptic_feedback_controller.c ****  *
 101:Core/Src/haptic_feedback_controller.c ****  * @return HAL_StatusTypeDef Status of the I2C operations.
 102:Core/Src/haptic_feedback_controller.c ****  */
 103:Core/Src/haptic_feedback_controller.c **** HAL_StatusTypeDef haptic_feedback_init_for_wideband_LRA(void)
 104:Core/Src/haptic_feedback_controller.c **** {
 105:Core/Src/haptic_feedback_controller.c ****     HAL_StatusTypeDef status = HAL_OK;
 106:Core/Src/haptic_feedback_controller.c **** 
 107:Core/Src/haptic_feedback_controller.c ****     // 1) Enable the DRV2605L driver pin
 108:Core/Src/haptic_feedback_controller.c ****     haptic_feedback_enable();
 109:Core/Src/haptic_feedback_controller.c **** 
 110:Core/Src/haptic_feedback_controller.c ****     // 2) Put the device in Internal Trigger Mode (0x00). 
 111:Core/Src/haptic_feedback_controller.c ****     //    This also clears STANDBY (bit 6 in MODE register).
 112:Core/Src/haptic_feedback_controller.c ****     status = haptic_feedback_set_mode(DRV2605L_MODE_INTERNAL_TRIGGER);
 113:Core/Src/haptic_feedback_controller.c ****     if (status != HAL_OK) {
 114:Core/Src/haptic_feedback_controller.c ****         return status;
 115:Core/Src/haptic_feedback_controller.c ****     }
 116:Core/Src/haptic_feedback_controller.c **** 
 117:Core/Src/haptic_feedback_controller.c ****     // 3) Select LRA in the FEEDBACK_CONTROL register (bit 7).
 118:Core/Src/haptic_feedback_controller.c ****     //    This ensures the device is configured for LRA rather than ERM.
 119:Core/Src/haptic_feedback_controller.c ****     status = haptic_feedback_set_actuator_type(LRA);
 120:Core/Src/haptic_feedback_controller.c ****     if (status != HAL_OK) {
 121:Core/Src/haptic_feedback_controller.c ****         return status;
 122:Core/Src/haptic_feedback_controller.c ****     }
 123:Core/Src/haptic_feedback_controller.c **** 
 124:Core/Src/haptic_feedback_controller.c ****     // 4) Write directly to CONTROL3 (Register 0x1D) to enable LRA open-loop.
 125:Core/Src/haptic_feedback_controller.c ****     status = haptic_feedback_set_open_loop(true);
 126:Core/Src/haptic_feedback_controller.c ****     if (status != HAL_OK) {
 127:Core/Src/haptic_feedback_controller.c ****         return status;
ARM GAS  /var/folders/bp/ytvqs5756l50d7lg2fzmjpcr0000gn/T//cc9bXJUW.s 			page 6


 128:Core/Src/haptic_feedback_controller.c ****     }
 129:Core/Src/haptic_feedback_controller.c **** 
 130:Core/Src/haptic_feedback_controller.c ****     // 5) Set OL_LRA_PERIOD (Register 0x20) for ~170 Hz
 131:Core/Src/haptic_feedback_controller.c ****     status = haptic_feedback_set_ol_lra_period(170);
 132:Core/Src/haptic_feedback_controller.c ****     if (status != HAL_OK) {
 133:Core/Src/haptic_feedback_controller.c ****         return status;
 134:Core/Src/haptic_feedback_controller.c ****     }
 135:Core/Src/haptic_feedback_controller.c **** 
 136:Core/Src/haptic_feedback_controller.c ****     // 6) (Optional) Set OD_CLAMP so the driver does not exceed ~2.5–3 V beyond rated voltage
 137:Core/Src/haptic_feedback_controller.c ****     //    in open-loop. Adjust as needed.
 138:Core/Src/haptic_feedback_controller.c ****     status = haptic_feedback_set_od_clamp(126);
 139:Core/Src/haptic_feedback_controller.c ****     if (status != HAL_OK) {
 140:Core/Src/haptic_feedback_controller.c ****         return status;
 141:Core/Src/haptic_feedback_controller.c ****     }
 142:Core/Src/haptic_feedback_controller.c **** 
 143:Core/Src/haptic_feedback_controller.c ****     return status;
 144:Core/Src/haptic_feedback_controller.c **** }
