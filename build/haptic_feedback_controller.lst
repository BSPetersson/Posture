  39:Core/Src/haptic_feedback_controller.c **** /**
  40:Core/Src/haptic_feedback_controller.c ****  * @brief Initializes the haptic feedback controller.
  41:Core/Src/haptic_feedback_controller.c ****  *
  42:Core/Src/haptic_feedback_controller.c ****  * This function starts the auto-calibration procedure.
  43:Core/Src/haptic_feedback_controller.c ****  */
  44:Core/Src/haptic_feedback_controller.c **** void haptic_feedback_controller_initialize(void) {
  45:Core/Src/haptic_feedback_controller.c ****     bool success = false;
  46:Core/Src/haptic_feedback_controller.c **** 
  47:Core/Src/haptic_feedback_controller.c ****     while (!success) {
  48:Core/Src/haptic_feedback_controller.c ****         HAL_StatusTypeDef status = haptic_feedback_init_for_wideband_LRA();
  49:Core/Src/haptic_feedback_controller.c ****         if (status == HAL_OK) {
  50:Core/Src/haptic_feedback_controller.c ****             success = true;
  51:Core/Src/haptic_feedback_controller.c ****         }
  52:Core/Src/haptic_feedback_controller.c ****         HAL_Delay(100);
  53:Core/Src/haptic_feedback_controller.c ****     }
  54:Core/Src/haptic_feedback_controller.c **** }
  55:Core/Src/haptic_feedback_controller.c **** 
  56:Core/Src/haptic_feedback_controller.c **** /**
  57:Core/Src/haptic_feedback_controller.c ****  * @brief Runs the auto-calibration procedure for the haptic feedback controller.
  58:Core/Src/haptic_feedback_controller.c ****  */
  59:Core/Src/haptic_feedback_controller.c **** bool haptic_feedback_run_auto_calibration_procedure(void) {
  60:Core/Src/haptic_feedback_controller.c ****     HAL_StatusTypeDef status;
  61:Core/Src/haptic_feedback_controller.c **** 
  62:Core/Src/haptic_feedback_controller.c ****     haptic_feedback_enable();
  63:Core/Src/haptic_feedback_controller.c ****     haptic_feedback_set_mode(DRV2605L_MODE_CALIBRATION);
  64:Core/Src/haptic_feedback_controller.c **** 
  65:Core/Src/haptic_feedback_controller.c ****     // Populate the input parameters required by the auto-calibration engine
  66:Core/Src/haptic_feedback_controller.c ****     status  = haptic_feedback_set_actuator_type(LRA);
  67:Core/Src/haptic_feedback_controller.c ****     status |= haptic_feedback_set_brake_factor(2);
  68:Core/Src/haptic_feedback_controller.c ****     status |= haptic_feedback_set_loop_gain(2);
  69:Core/Src/haptic_feedback_controller.c ****     status |= haptic_feedback_set_rated_voltage(105);
  70:Core/Src/haptic_feedback_controller.c ****     status |= haptic_feedback_set_od_clamp(126);
ARM GAS  /var/folders/bp/ytvqs5756l50d7lg2fzmjpcr0000gn/T//cc9bXJUW.s 			page 5


  71:Core/Src/haptic_feedback_controller.c ****     status |= haptic_feedback_set_auto_calibration_time(3);
  72:Core/Src/haptic_feedback_controller.c ****     status |= haptic_feedback_set_drive_time(24);
  73:Core/Src/haptic_feedback_controller.c ****     status |= haptic_feedback_set_sample_time(3);
  74:Core/Src/haptic_feedback_controller.c ****     status |= haptic_feedback_set_blanking_time(1);
  75:Core/Src/haptic_feedback_controller.c ****     status |= haptic_feedback_set_idiss_time(1);
  76:Core/Src/haptic_feedback_controller.c ****     status |= haptic_feedback_set_zc_det_time(0);
  77:Core/Src/haptic_feedback_controller.c **** 
  78:Core/Src/haptic_feedback_controller.c ****     haptic_feedback_start();
  79:Core/Src/haptic_feedback_controller.c **** 
  80:Core/Src/haptic_feedback_controller.c ****     HAL_Delay(5000); // Wait for the calibration to complete
  81:Core/Src/haptic_feedback_controller.c **** 
  82:Core/Src/haptic_feedback_controller.c ****     uint8_t diagnostic_result;
  83:Core/Src/haptic_feedback_controller.c ****     status |= haptic_feedback_get_calibration_diagnostic_result(&diagnostic_result);
  84:Core/Src/haptic_feedback_controller.c **** 
  85:Core/Src/haptic_feedback_controller.c ****     // checkout if bit 3 is 0 or 1. if 1, calibration failed and we should retry
  86:Core/Src/haptic_feedback_controller.c ****     while ((diagnostic_result & 0x08) != 0) {
  87:Core/Src/haptic_feedback_controller.c ****         return false;
  88:Core/Src/haptic_feedback_controller.c ****     }
  89:Core/Src/haptic_feedback_controller.c **** 
  90:Core/Src/haptic_feedback_controller.c ****     // Pause for a moment to allow the calibration to complete
  91:Core/Src/haptic_feedback_controller.c ****     HAL_Delay(5000);
  92:Core/Src/haptic_feedback_controller.c **** 
  93:Core/Src/haptic_feedback_controller.c ****     return true;
  94:Core/Src/haptic_feedback_controller.c **** }
