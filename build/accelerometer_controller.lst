 181:Core/Src/accelerometer_controller.c **** 
 182:Core/Src/accelerometer_controller.c ****     // Store the current vector in the measurements history
 183:Core/Src/accelerometer_controller.c ****     last_measurements_history[last_measurements_history_index][0] = accelerometer_data.x_mps2;
