 170:Core/Src/accelerometer_controller.c **** void accelerometer_controller_update(void)
 171:Core/Src/accelerometer_controller.c **** {
 172:Core/Src/accelerometer_controller.c ****     uint32_t now = HAL_GetTick();
 173:Core/Src/accelerometer_controller.c ****     accel_data_t accelerometer_data;
