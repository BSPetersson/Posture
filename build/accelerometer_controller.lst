 169:Core/Src/accelerometer_controller.c **** // Update Function
 170:Core/Src/accelerometer_controller.c **** // -----------------------------
 171:Core/Src/accelerometer_controller.c **** void accelerometer_controller_update(void)
 172:Core/Src/accelerometer_controller.c **** {
 173:Core/Src/accelerometer_controller.c ****     uint32_t now = HAL_GetTick();
 174:Core/Src/accelerometer_controller.c ****     
 175:Core/Src/accelerometer_controller.c ****     // Skip accelerometer readings if haptic feedback is active
 176:Core/Src/accelerometer_controller.c ****     if (haptic_feedback_is_active()) {
 177:Core/Src/accelerometer_controller.c ****         return;
 178:Core/Src/accelerometer_controller.c ****     }
 179:Core/Src/accelerometer_controller.c ****     
 180:Core/Src/accelerometer_controller.c ****     accel_data_t accelerometer_data;
 181:Core/Src/accelerometer_controller.c ****     HAL_StatusTypeDef status = accelerometer_read_mps2(&accelerometer_data);
 182:Core/Src/accelerometer_controller.c ****     if (status != HAL_OK)
 183:Core/Src/accelerometer_controller.c ****     {
 184:Core/Src/accelerometer_controller.c ****         return;
 185:Core/Src/accelerometer_controller.c ****     }
 186:Core/Src/accelerometer_controller.c **** 
 187:Core/Src/accelerometer_controller.c ****     latest_accel_data = accelerometer_data;
