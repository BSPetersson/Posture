  36:Core/Src/posture_controller.c **** // normalize_vector: Normalizes a 3D vector in place.
  37:Core/Src/posture_controller.c **** static void normalize_vector(float v[3]) {
  38:Core/Src/posture_controller.c ****     float mag = sqrtf(v[0]*v[0] + v[1]*v[1] + v[2]*v[2]);
  39:Core/Src/posture_controller.c ****     if (mag > 0.0f) {
  40:Core/Src/posture_controller.c ****         v[0] /= mag;
  41:Core/Src/posture_controller.c ****         v[1] /= mag;
  42:Core/Src/posture_controller.c ****         v[2] /= mag;
  43:Core/Src/posture_controller.c ****     }
  44:Core/Src/posture_controller.c **** }
