  90:Core/Src/posture_controller.c **** 
  91:Core/Src/posture_controller.c ****     // If the angle is less than the threshold, update the last good posture time
  92:Core/Src/posture_controller.c ****     // Otherwise, update the last bad posture time
  93:Core/Src/posture_controller.c ****     if (error_angle < threshold_angle)
  94:Core/Src/posture_controller.c ****     {
  95:Core/Src/posture_controller.c ****         last_good_posture_time = now;
  96:Core/Src/posture_controller.c ****     }
  97:Core/Src/posture_controller.c ****     else
  98:Core/Src/posture_controller.c ****     {
  99:Core/Src/posture_controller.c ****         last_bad_posture_time = now;
 100:Core/Src/posture_controller.c ****     }
 101:Core/Src/posture_controller.c **** 
 102:Core/Src/posture_controller.c ****     // If the last good posture time is greater than the last bad posture time,
 103:Core/Src/posture_controller.c ****     // and the difference is greater than the good posture transition time,
 104:Core/Src/posture_controller.c ****     // then we are in good posture.
 105:Core/Src/posture_controller.c ****     if (last_good_posture_time > last_bad_posture_time &&
 106:Core/Src/posture_controller.c ****         (last_good_posture_time - last_bad_posture_time) > GOOD_POSTURE_TRANSITION_TIME_MS &&
 107:Core/Src/posture_controller.c ****         !is_posture_correct)
 108:Core/Src/posture_controller.c ****     {
 109:Core/Src/posture_controller.c ****         is_posture_correct = true;
 110:Core/Src/posture_controller.c ****         did_calibrate = false;
 111:Core/Src/posture_controller.c ****         notify_posture_correct();
 112:Core/Src/posture_controller.c ****         return;
 113:Core/Src/posture_controller.c ****     }
 114:Core/Src/posture_controller.c **** 
 115:Core/Src/posture_controller.c ****     // If the last bad posture time is greater than the last good posture time,
 116:Core/Src/posture_controller.c ****     // and the difference is greater than the bad posture transition time,
 117:Core/Src/posture_controller.c ****     // then we are in bad posture.
 118:Core/Src/posture_controller.c ****     if (last_bad_posture_time > last_good_posture_time &&
 119:Core/Src/posture_controller.c ****         (last_bad_posture_time - last_good_posture_time) > BAD_POSTURE_TRANSITION_TIME_MS &&
 120:Core/Src/posture_controller.c ****         is_posture_correct)
 121:Core/Src/posture_controller.c ****     {
 122:Core/Src/posture_controller.c ****         is_posture_correct = false;
 123:Core/Src/posture_controller.c ****         
 124:Core/Src/posture_controller.c ****         // Check if bad posture has been maintained for 3 minutes (180000 ms)
 125:Core/Src/posture_controller.c ****         if ((now - last_bad_posture_time) > BAD_POSTURE_RESET_TIME_MS) {
 126:Core/Src/posture_controller.c ****             reset_good_posture_history(); // Reset history if bad posture for 3 minutes
 127:Core/Src/posture_controller.c ****         }
 128:Core/Src/posture_controller.c ****         return;
 129:Core/Src/posture_controller.c ****     }
 130:Core/Src/posture_controller.c **** 
 131:Core/Src/posture_controller.c ****     // If the posture is correct and the last good posture time is greater than the good posture ve
 132:Core/Src/posture_controller.c ****     // and the device have not calibrated yet, then start the calibration procedure.
 133:Core/Src/posture_controller.c ****     if (is_posture_correct &&
 134:Core/Src/posture_controller.c ****         !did_calibrate)
 135:Core/Src/posture_controller.c ****     {
 136:Core/Src/posture_controller.c ****         start_calibration_procedure();
 137:Core/Src/posture_controller.c ****         return;
 138:Core/Src/posture_controller.c ****     }
 139:Core/Src/posture_controller.c **** 
 140:Core/Src/posture_controller.c ****     if (!is_posture_correct)
 141:Core/Src/posture_controller.c ****     {
 142:Core/Src/posture_controller.c ****         handle_bad_posture();
 143:Core/Src/posture_controller.c ****         return;
 144:Core/Src/posture_controller.c ****     }
 145:Core/Src/posture_controller.c **** }
