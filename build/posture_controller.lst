  95:Core/Src/posture_controller.c **** 
  96:Core/Src/posture_controller.c ****     if (accelerometer_mode == SUPER_STILL) {
  97:Core/Src/posture_controller.c ****         
  98:Core/Src/posture_controller.c ****     }
  99:Core/Src/posture_controller.c **** 
 100:Core/Src/posture_controller.c ****     // Get the latest accelerometer vector
 101:Core/Src/posture_controller.c ****     accel_data_t accelerometer_vector = accelerometer_controller_get_latest_data();
 102:Core/Src/posture_controller.c ****     current_accelerometer_vector[0] = accelerometer_vector.x_mps2;
 103:Core/Src/posture_controller.c ****     current_accelerometer_vector[1] = accelerometer_vector.y_mps2;
 104:Core/Src/posture_controller.c ****     current_accelerometer_vector[2] = accelerometer_vector.z_mps2;
 105:Core/Src/posture_controller.c ****     
 106:Core/Src/posture_controller.c ****     // Check for button long press
 107:Core/Src/posture_controller.c ****     button_event_t button_event = button_controller_get_event();
 108:Core/Src/posture_controller.c ****     if (button_event == BUTTON_EVENT_LONG_PRESS) {
 109:Core/Src/posture_controller.c ****         reset_good_posture_vector();
 110:Core/Src/posture_controller.c ****         notify_posture_correct(); // Provide feedback that recalibration occurred
 111:Core/Src/posture_controller.c ****         did_calibrate = true;
 112:Core/Src/posture_controller.c ****         return;
 113:Core/Src/posture_controller.c ****     }
 114:Core/Src/posture_controller.c **** 
 115:Core/Src/posture_controller.c ****     // Get the angle between the current accelerometer vector and the good posture vector
 116:Core/Src/posture_controller.c ****     float error_angle = get_angle_between_vectors(current_accelerometer_vector, good_posture_vector
 117:Core/Src/posture_controller.c **** 
 118:Core/Src/posture_controller.c ****     // If the angle is greater than the unrealistic posture threshold, do nothing
 119:Core/Src/posture_controller.c ****     if (error_angle > UNREALISTIC_POSTURE_THRESHOLD_RADIANS)
 120:Core/Src/posture_controller.c ****     {
 121:Core/Src/posture_controller.c ****         return;
 122:Core/Src/posture_controller.c ****     }
 123:Core/Src/posture_controller.c **** 
 124:Core/Src/posture_controller.c ****     // If the angle is less than the threshold, update the last good posture time
 125:Core/Src/posture_controller.c ****     // Otherwise, update the last bad posture time
 126:Core/Src/posture_controller.c ****     if (error_angle < threshold_angle)
 127:Core/Src/posture_controller.c ****     {
 128:Core/Src/posture_controller.c ****         last_good_posture_time = now;
 129:Core/Src/posture_controller.c ****     }
 130:Core/Src/posture_controller.c ****     else
 131:Core/Src/posture_controller.c ****     {
 132:Core/Src/posture_controller.c ****         last_bad_posture_time = now;
 133:Core/Src/posture_controller.c ****     }
 134:Core/Src/posture_controller.c **** 
 135:Core/Src/posture_controller.c ****     // If the last good posture time is greater than the last bad posture time,
 136:Core/Src/posture_controller.c ****     // and the difference is greater than the good posture transition time,
 137:Core/Src/posture_controller.c ****     // then we are in good posture.
 138:Core/Src/posture_controller.c ****     if (last_good_posture_time > last_bad_posture_time &&
 139:Core/Src/posture_controller.c ****         (last_good_posture_time - last_bad_posture_time) > GOOD_POSTURE_TRANSITION_TIME_MS &&
 140:Core/Src/posture_controller.c ****         !is_posture_correct)
 141:Core/Src/posture_controller.c ****     {
 142:Core/Src/posture_controller.c ****         is_posture_correct = true;
 143:Core/Src/posture_controller.c ****         did_calibrate = false;
 144:Core/Src/posture_controller.c ****         notify_posture_correct();
 145:Core/Src/posture_controller.c ****     }
 146:Core/Src/posture_controller.c **** 
ARM GAS  /var/folders/bp/ytvqs5756l50d7lg2fzmjpcr0000gn/T//ccuY7655.s 			page 4


 147:Core/Src/posture_controller.c ****     // If the last bad posture time is greater than the last good posture time,
 148:Core/Src/posture_controller.c ****     // and the difference is greater than the bad posture transition time,
 149:Core/Src/posture_controller.c ****     // then we are in bad posture.
 150:Core/Src/posture_controller.c ****     if (last_bad_posture_time > last_good_posture_time &&
 151:Core/Src/posture_controller.c ****         (last_bad_posture_time - last_good_posture_time) > BAD_POSTURE_TRANSITION_TIME_MS &&
 152:Core/Src/posture_controller.c ****         is_posture_correct)
 153:Core/Src/posture_controller.c ****     {
 154:Core/Src/posture_controller.c ****         is_posture_correct = false;
 155:Core/Src/posture_controller.c ****     }
 156:Core/Src/posture_controller.c **** 
 157:Core/Src/posture_controller.c ****     // If the posture is correct and the last good posture time is greater than the good posture ve
 158:Core/Src/posture_controller.c ****     // and the device have not calibrated yet, then start the calibration procedure.
 159:Core/Src/posture_controller.c ****     if (is_posture_correct &&
 160:Core/Src/posture_controller.c ****         !did_calibrate)
 161:Core/Src/posture_controller.c ****     {
 162:Core/Src/posture_controller.c ****         start_calibration_procedure();
 163:Core/Src/posture_controller.c ****     }
 164:Core/Src/posture_controller.c **** 
 165:Core/Src/posture_controller.c ****     if (!is_posture_correct)
 166:Core/Src/posture_controller.c ****     {
 167:Core/Src/posture_controller.c ****         handle_bad_posture();
 168:Core/Src/posture_controller.c ****     }
